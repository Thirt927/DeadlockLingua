<?xml version="1.0" encoding="utf-8"?>
<!-- Babel Tower override: original players_list_entry plus hidden hero label for account_id roster collection. -->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/players_list_entry.vcss_c" />
	</styles>
	<CitadelPlayersListEntry class="LCTPlayerRow">
		<Panel class="Controls">
			<Button class="MuteButton ToggleMuteButton" onmouseover="UIShowTextTooltip( #citadel_mute_player )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPlayerListEntrySetMuted( true )" />
			<Button class="UnmuteButton ToggleMuteButton" onmouseover="UIShowTextTooltip( #citadel_unmute_player )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPlayerListEntrySetMuted( false )" />
		</Panel>
		<Panel id="MainContents" hittestchildren="false">
			<CitadelHeroBadge id="HeroBadge" />
			<Panel class="Details">
				<Label class="PlayerName" text="{s:player_name}" />
				<Label class="PlayerHero" text="#Citadel_Player_Level_HeroLevel" />
			</Panel>
			<Label id="LCTRowHero" text="{g:citadel_hero_name:hero_id}" visible="false" hittest="false" style="opacity: 0; width: 0px; height: 0px; overflow: clip;" />
			<Label id="LCTRowAccount" text="{i:r:account_id}" visible="false" hittest="false" style="opacity: 0; width: 0px; height: 0px; overflow: clip;" />
		</Panel>
	</CitadelPlayersListEntry>
</root>
