<?xml version="1.0" encoding="utf-8"?>
<!--
  Babel Tower: Deadlock 大厅(HUD)聊天布局覆盖
  基于原版 panorama/layout/hudchat.xml 的反编译重建结构(Valve 素材,保留原结构),
  额外加入 LinguaChat 的样式/脚本引用、设置按钮与设置面板(与 chat.xml 一致),
  使大厅聊天同样支持翻译/日志/发送前翻译。
  原版结构(反编译):CitadelHudChat > FullChatContainer > ChatMainPanel >
    ChatLinesArea > (ChatLinesContainer > ChatLinesWrapper > ChatLinesPanel) | ChatDisabled | ChatControls
  注意:Panorama 的 Button 不渲染 text 属性,按钮文字必须用内嵌 <Label>。
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/hudchat.vcss_c" />
		<include src="s2r://panorama/styles/lingua_chat.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/lingua_chat.vjs_c" />
	</scripts>
	<CitadelHudChat defaultfocus="ChatInput" hittest="false">
		<Panel id="FullChatContainer" hittest="false">
			<Panel id="ChatMainPanel" hittest="false">
				<Panel id="ChatLinesArea" hittest="false">
					<Panel id="ChatLinesContainer" hittest="false">
						<Panel id="ChatLinesWrapper" hittest="false">
							<Panel id="ChatLinesPanel" hittest="false" />
						</Panel>
					</Panel>
					<Panel id="ChatLinesOverlay" hittest="false" />
				</Panel>
				<Panel id="ChatDisabled">
					<Label text="#Citadel_Hud_ChatDisabled" />
				</Panel>
				<Panel id="ChatControls">
					<Label id="ChatTargetLabel" text="#citadel_chat_placeholder" />
					<TextEntry id="ChatInput" oninputsubmit="LCTOnChatSubmit();" onblur="CitadelChatTextBlur();" placeholder="" maxchars="1024" />
					<Button id="LCTSettingsButton" class="LCTSettingsButton" onactivate="LCTToggleSettings();">
						<Label text="译" />
					</Button>
				</Panel>
			</Panel>
		</Panel>
		<!-- Babel Tower 隐藏 HTML 桥面板(必须用 <HTML> 标签在 XML 声明,运行时 CreatePanel 不生效) -->
		<HTML id="LCTBridgePanel" class="LCTBridgePanel" />
	</CitadelHudChat>
</root>
